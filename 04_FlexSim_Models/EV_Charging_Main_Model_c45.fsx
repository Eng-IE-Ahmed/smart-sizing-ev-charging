          <node f="442" dt="2"><name>searchRequirements</name><data>/**Get all Sources in the input group*/
StatisticsCollector collector = ownerobject(c);
treenode listenTo = param(1);

Array inputObjects = [];
treenode inputGroup = collector.InputGroup;
if (inputGroup) {
	inputObjects = collector.InputGroup.as(Group).toFlatArray();
}

Array outputObjects = [];
treenode outputGroup = collector.OutputGroup;
if (outputGroup) {
	outputObjects = outputGroup.as(Group).toFlatArray();
}

collector.InputObjects = inputObjects;
collector.OutputObjects = outputObjects;

Array result;
for (int i = 1; i &lt;= inputObjects.length; i++) {
	if (isclasstype(inputObjects[i], "Source")) {
		result.push(inputObjects[i]);
		inputObjects.splice(i, 1);
		i--;
	}
}

result.push(-1);
return result;</data></node>
