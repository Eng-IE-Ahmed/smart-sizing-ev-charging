StatisticsCollector collector = ownerobject(c);
var data = collector.collectedData;
treenode current = data.eventNode;
Object instance = data.processFlowInstance;
treenode table = collector.StateTable;
if (!objectexists(table))
	return Array();
Table stateTable = Table(collector.StateTable.name);
Array values;
collector.timeMap = Map();
Array objects = collector.Objects.as(Group).toFlatArray();
Array analysisScoreMap = [1, 0, 2];

for (int i =1 ; i &lt;= objects.length; i++){
	for (int j = 1; j &lt;= stateTable.numRows; j++){
		int analysis = stateTable[j][3];
		if (analysis == 2 &amp;&amp; !collector.ShowExcludedStates) {
			continue;
		}
		int score = analysisScoreMap[analysis + 1] + 10 * i;
		values.push([objects[i],objects[i].stats.state(collector.Profile),stateTable[j][1],stateTable[j][2], score]);//Object, Profile, State, Display Name
	}
}
return values;</data></node>
