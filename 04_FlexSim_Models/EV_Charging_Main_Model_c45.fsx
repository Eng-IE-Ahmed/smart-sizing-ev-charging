   <node f="442" dt="2"><name>interarrivaltime</name><data>Object current = ownerobject(c);
/* D4-B5 GUI copy: next arrival time from the Cars table; at time 0 (model reset) the car counters are reset */
Table cars = Table("Cars");
if (Model.time &lt;= 0) {
	current.nextCar = 0;
	Object qq = Model.find("ChargeQueue");
	qq.served = 0;
}
int k = current.nextCar + 1;
if (k &gt; cars.numRows)
	return 1000000000;
current.nextCar = k;
return cars[k][1] - Model.time;</data></node>
