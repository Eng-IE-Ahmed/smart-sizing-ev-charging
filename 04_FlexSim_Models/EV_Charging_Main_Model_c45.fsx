          <node f="442" dt="2"><name>valueNode</name><data>/**Custom Code*/
StatisticsCollector collector = ownerobject(c);
var data = collector.collectedData;
treenode current = data.eventNode;
Object instance = data.processFlowInstance;
Table stateTable = Table(collector.StateTable.name);
Object object = data.rowValue[1];
Map timeMap = collector.timeMap;

var iter = timeMap.find(object);
int needsUpdate = 0;
Array result;
if (!iter) {
	needsUpdate = 1;
} else if (iter.value[1] &lt; Model.time) {
	needsUpdate = 1;
} else {
	result = iter.value;
}

if (needsUpdate) {
	result = [Model.time, getstatetableutilization(stateTable, data.rowValue[2])];
	timeMap[object] = result;
}

return result[2];</data></node>
