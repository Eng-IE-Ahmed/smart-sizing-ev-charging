          <node f="442" dt="2"><name>searchRequirements</name><data>/**Get all Process Flow Sources in the input group*/
StatisticsCollector collector = ownerobject(c);
treenode listenTo = param(1);

Array inputObjects = collector.InputObjects;
Array result;
Array pfSources = ["ScheduledSource", "DateTimeSource", "EventTriggerSource", "InterArrivalSource"];
for (int i = 1; i &lt;= inputObjects.length; i++) {
	for (int j = 1; j &lt;= pfSources.length; j++) {
		if (isclasstype(inputObjects[i], "ProcessFlow::" + pfSources[j])) {
			result.push(inputObjects[i]);
			inputObjects.splice(i, 1);
			i--;
			break;
		}
	}
}

result.push(-1);
return result;</data></node>
